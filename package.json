{
  "name": "avatar-narration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP service: upload narration audio, get back an MP4 of a Spatius avatar speaking it (Direct Mode, headless Chromium).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "bench": "tsx scripts/bench.ts",
    "compose": "tsx scripts/compose.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@spatius/avatarkit": "1.3.8",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "playwright": "1.62.1",
    "tsx": "^4.19.0",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
