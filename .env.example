# --- Spatius (required) ---------------------------------------------------
# From the Spatius console. The API key stays on this server; it is only used
# to mint short-lived session tokens and is never sent to the browser page.
SPATIUS_APP_ID=
SPATIUS_API_KEY=
SPATIUS_AVATAR_ID=
# us-west | ap-northeast | cn-beijing
SPATIUS_REGION=us-west

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# If set, every request except GET /health must send it as
#   Authorization: Bearer <API_KEY>   (or  X-API-Key: <API_KEY>)
# Each render spends paid Spatius credits, so set this anywhere reachable by
# anything other than your own backend.
API_KEY=

# --- Limits ---------------------------------------------------------------
# Renders run in real time and are CPU/GPU heavy; keep this at 1 unless you
# have verified your hardware can render several avatars at once without
# frame freezes.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=20
# Rejected before any Spatius credit is spent.
MAX_AUDIO_SECONDS=600
MAX_UPLOAD_MB=100
# Finished jobs (and their MP4) are deleted this long after they finish.
JOB_TTL_MINUTES=60

# --- Internals ------------------------------------------------------------
# How long to wait for the avatar assets to load in the headless page. The
# first load after a long idle period can be slow. One automatic retry
# happens if this times out.
AVATAR_LOAD_TIMEOUT_SECONDS=120
DATA_DIR=./data
# Loopback-only port for the internal page the headless browser loads.
VITE_INTERNAL_PORT=5199
# auto | webgl. "webgl" makes the SDK use its WebGL renderer instead of WebGPU
# (needed on hosts whose software WebGPU renders a blank avatar).
RENDER_BACKEND=auto
# Extra Chromium flags, space-separated. Needed on hosts without a GPU (see
# README, "Running in Docker").
CHROMIUM_EXTRA_ARGS=
# 1 = echo the headless page's console output into the server log.
LOG_BROWSER=0
LOG_LEVEL=info
